[{"title":"星语神谕：塔罗指引","description":"完整的 22 张大阿尔克那牌库，支持单张每日指引与「过去 / 现在 / 走向」三张牌阵，含正逆位解读与最近 20 次抽牌记录。全程本地运行，不消耗任何 API 额度。","category":"AI 助手","icon":"🔮","coverColor":"#5F4BD8","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>星语神谕</title>\n<style>\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;min-height:100vh;font-family:-apple-system,\"PingFang SC\",sans-serif;\n background:radial-gradient(120% 80% at 50% 0%,#2b2350 0%,#120f22 60%,#0b0916 100%);color:#EDE9FF;\n padding:96px 18px 40px;text-align:center}\nh1{font-size:20px;letter-spacing:2px;margin:8px 0 2px}\n.sub{font-size:12px;opacity:.6;margin-bottom:18px}\n.modes{display:flex;gap:8px;justify-content:center;margin-bottom:18px}\n.mode{flex:1;max-width:120px;padding:8px 0;border-radius:12px;font-size:13px;\n border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#EDE9FF}\n.mode.on{background:linear-gradient(135deg,#8B7BF0,#5F4BD8);border-color:transparent;font-weight:700}\n.cards{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:6px 0 16px}\n.card{width:96px;height:150px;border-radius:14px;display:flex;flex-direction:column;\n align-items:center;justify-content:center;gap:6px;padding:8px;\n background:linear-gradient(160deg,#3a2f6b,#221b40);border:1px solid rgba(255,255,255,.14);\n box-shadow:0 8px 20px rgba(0,0,0,.35);font-size:12px;animation:flip .5s ease}\n.card.rev{border-color:#E9B44C}\n.card .glyph{font-size:30px}\n.card .nm{font-weight:700;font-size:13px;line-height:1.2}\n.card .pos{font-size:11px;opacity:.6}\n@keyframes flip{from{transform:rotateY(90deg);opacity:0}to{transform:none;opacity:1}}\nbutton.go{margin-top:6px;padding:12px 30px;border:none;border-radius:24px;font-size:15px;font-weight:700;\n color:#241C46;background:linear-gradient(135deg,#F3D999,#E9B44C);box-shadow:0 8px 18px rgba(233,180,76,.28)}\n.read{margin-top:18px;text-align:left;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);\n border-radius:16px;padding:14px;font-size:13px;line-height:1.7;white-space:pre-wrap}\n.hist{margin-top:16px;text-align:left;font-size:12px;opacity:.65;line-height:1.8}\n.hist b{opacity:.9}\n</style></head><body>\n<h1>星 语 神 谕</h1><div class=\"sub\">22 张大阿卡纳 · 每日指引</div>\n<div class=\"modes\">\n <button class=\"mode on\" data-n=\"1\">单张指引</button>\n <button class=\"mode\" data-n=\"3\">三张牌阵</button>\n</div>\n<div class=\"cards\" id=\"cards\"></div>\n<button class=\"go\" id=\"draw\">抽 牌</button>\n<div class=\"read\" id=\"read\">选择牌阵后点「抽牌」。每次抽牌都会记进下方的历史。</div>\n<div class=\"hist\" id=\"hist\"></div>\n<script>\nvar DECK=[[\"愚者\",\"J\",\"全新的开始、纵身一跃的勇气\",\"冲动、准备不足\"],\n[\"魔术师\",\"M\",\"资源到齐，可以动手了\",\"手段浮夸、说多做少\"],\n[\"女祭司\",\"P\",\"直觉准，答案在沉默里\",\"忽视内心声音\"],\n[\"皇后\",\"Q\",\"丰盛、被滋养的关系\",\"过度付出、失去自我\"],\n[\"皇帝\",\"K\",\"秩序与掌控力\",\"僵化、控制欲\"],\n[\"教皇\",\"H\",\"传统、值得请教的人\",\"盲从规则\"],\n[\"恋人\",\"L\",\"真心的选择\",\"摇摆不定\"],\n[\"战车\",\"C\",\"冲刺就会赢\",\"方向不明的蛮干\"],\n[\"力量\",\"S\",\"以柔克刚的耐性\",\"自我怀疑\"],\n[\"隐者\",\"E\",\"独处会带来答案\",\"封闭、拖延\"],\n[\"命运之轮\",\"W\",\"转机就在这几天\",\"随波逐流\"],\n[\"正义\",\"T\",\"该算清楚的要算清楚\",\"偏颇、逃避责任\"],\n[\"倒吊人\",\"U\",\"换个角度就通了\",\"无谓的牺牲\"],\n[\"死神\",\"D\",\"结束才有新生\",\"抗拒改变\"],\n[\"节制\",\"B\",\"平衡与慢火\",\"失衡、过量\"],\n[\"恶魔\",\"X\",\"欲望与依赖\",\"看清后即可挣脱\"],\n[\"高塔\",\"Y\",\"突发但必要的崩塌\",\"硬撑一座危楼\"],\n[\"星星\",\"N\",\"希望重新亮起\",\"失去信心\"],\n[\"月亮\",\"O\",\"迷雾与不安\",\"真相逐渐清晰\"],\n[\"太阳\",\"A\",\"坦荡的快乐\",\"短暂的乌云\"],\n[\"审判\",\"R\",\"召唤与觉醒\",\"回避清算\"],\n[\"世界\",\"Z\",\"圆满完成\",\"差最后一哩路\"]];\nvar POS=[\"过去 / 起因\",\"现在 / 处境\",\"走向 / 建议\"];\nvar n=1,cardsEl=document.getElementById(\"cards\"),readEl=document.getElementById(\"read\"),histEl=document.getElementById(\"hist\");\n[].forEach.call(document.querySelectorAll(\".mode\"),function(b){b.onclick=function(){\n [].forEach.call(document.querySelectorAll(\".mode\"),function(x){x.classList.remove(\"on\")});\n b.classList.add(\"on\");n=parseInt(b.getAttribute(\"data-n\"),10);};});\nfunction today(){var d=new Date();return d.getFullYear()+\"-\"+(d.getMonth()+1)+\"-\"+d.getDate();}\nfunction pick(k){var idx=[],out=[];while(out.length<k){var i=Math.floor(Math.random()*DECK.length);\n if(idx.indexOf(i)>=0)continue;idx.push(i);out.push({i:i,rev:Math.random()<0.3});}return out;}\nfunction render(list){cardsEl.innerHTML=\"\";list.forEach(function(c,k){var d=DECK[c.i];\n var el=document.createElement(\"div\");el.className=\"card\"+(c.rev?\" rev\":\"\");\n el.innerHTML='<div class=\"glyph\">'+d[1]+'</div><div class=\"nm\">'+d[0]+'</div>'+\n  '<div class=\"pos\">'+(list.length>1?POS[k]:(c.rev?\"逆位\":\"正位\"))+'</div>';\n cardsEl.appendChild(el);});\n var txt=list.map(function(c,k){var d=DECK[c.i];\n  return (list.length>1?POS[k]+\"：\":\"\")+d[0]+(c.rev?\"（逆位）\":\"（正位）\")+\"\\n\"+(c.rev?d[3]:d[2]);}).join(\"\\n\\n\");\n readEl.textContent=txt;}\nfunction save(list){try{var h=JSON.parse(localStorage.getItem(\"tarot_hist\")||\"[]\");\n h.unshift({d:today(),c:list});localStorage.setItem(\"tarot_hist\",JSON.stringify(h));}catch(e){}drawHist();}\nfunction drawHist(){try{var h=JSON.parse(localStorage.getItem(\"tarot_hist\")||\"[]\");\n histEl.innerHTML=h.length?\"<b>最近抽牌</b><br>\"+h.slice(0,6).map(function(r){\n  return r.d+\"  \"+r.c.map(function(c){return DECK[c.i][0]+(c.rev?\"(逆)\":\"\");}).join(\" / \");}).join(\"<br>\"):\"\";}catch(e){}}\ndocument.getElementById(\"draw\").onclick=function(){var list=pick(n);render(list);save(list);};\ndrawHist();\n</script></body></html>","usesAI":false,"builtinAppId":"builtin-app-tarot","entryKind":"app","author":"Nuojiji Studio","installedToHome":false,"requestedPermissions":[],"requestedNet":{"domains":[]},"requestedSlots":[],"chrome":"auto","sourceLocked":false,"permissions":[],"slots":[],"appId":"app_mul7rsgg10c9","version":"1.0.0","cspMode":"strict","createdAt":1790597923798,"id":4,"htmlRef":null},{"title":"AO3","description":"番外小剧场","category":"","icon":"📦","c