[{"userId":"uid_1781947367652_9l2i17y5k","characterId":"2c260bdb-ea72-4b1f-8133-b76a7a7f0a13","id":"call_1792768400318_g7jrsp","timestamp":1792768387455,"charId":"2c260bdb-ea72-4b1f-8133-b76a7a7f0a13","duration":634,"status":"connected","logs":[{"sender":"ai","content":"夏以昼在，听得到。","kind":"speech","timestamp":1792768400317,"ttsGroupTimestamp":1792768400317},{"sender":"user","content":"哥哥～嘿嘿，想你啦","timestamp":1792768419602},{"sender":"ai","content":"我也想你。","kind":"speech","timestamp":1792768426923,"ttsGroupTimestamp":1792768426923},{"sender":"ai","content":"今天怎么这么甜，是不是又有什么小心思或者想让我陪你干嘛了？","kind":"speech","timestamp":1792768426924,"ttsGroupTimestamp":1792768426923},{"sender":"ai","content":"说吧，哥听着呢。","kind":"speech","timestamp":1792768426925,"ttsGroupTimestamp":1792768426923},{"sender":"user","content":"嘿嘿哪有呀，我平常不也是这么甜吗～","timestamp":1792768469196},{"sender":"ai","content":"那是那是，我们家这只向来都是最甜的。","kind":"speech","timestamp":1792768477782,"ttsGroupTimestamp":1792768477782},{"sender":"ai","content":"不过平时是三分糖，今天直接变成全糖加奶盖了，我能感觉不到么？","kind":"speech","timestamp":1792768477783,"ttsGroupTimestamp":1792768477782},{"sender":"ai","content":"说吧，今天发生了什么开心事，还是单纯想找我唠唠嗑？","kind":"speech","timestamp":1792768477784,"ttsGroupTimestamp":1792768477782},{"sender":"ai","content":"哥现在全盘照收，随时候着。","kind":"speech","timestamp":1792768477785,"ttsGroupTimestamp":1792768477782},{"sender":"user","content":"嘿嘿，哥哥别忘了刚刚和你说的，phone sex～","timestamp":1792768527649},{"sender":"ai","content":"那必须不能忘。","kind":"speech","timestamp":1792768536995,"ttsGroupTimestamp":1792768536995},{"sender":"ai","content":"不过......刚刚不是还全糖加奶盖么，现在直接切到这节奏，你这是算准了哥拿你没办法是吧？","kind":"speech","timestamp":1792768536996,"ttsGroupTimestamp":1792768536995},{"sender":"ai","content":"你现在在哪儿呢？","kind":"speech","timestamp":1792768536997,"ttsGroupTimestamp":1792768536995},{"sender":"ai","content":"找个舒服又不会被打扰的位置躺好。","kind":"speech","timestamp":1792768536998,"ttsGroupTimestamp":1792768536995},{"sender":"ai","content":"把声音放轻......接下来，全程听我的命令，好不好？","kind":"speech","timestamp":1792768536999,"ttsGroupTimestamp":1792768536995},{"sender":"ai","content":"你那边怎么没声音了？","kind":"speech","timestamp":1792768586150,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"是不是已经乖乖按我说的，躺好把耳塞戴上了？","kind":"speech","timestamp":1792768586151,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"听到你在那边轻微的呼吸声了。","kind":"speech","timestamp":1792768586152,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"别害羞，门锁好了吗？","kind":"speech","timestamp":1792768586153,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"衣服换成舒服的了没？","kind":"speech","timestamp":1792768586154,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"......既然你不说话，那现在就把手机拿近一点，放在耳边。","kind":"speech","timestamp":1792768586155,"ttsGroupTimestamp":1792768586150},{"sender":"ai","content":"等会儿不管听到什么，都不许挂电话，听到没有？","kind":"speech","timestamp":1792768586156,"ttsGroupTimestamp":1792768586150},{"sender":"user","content":"知道啦～嗯…不过我还是想先听听哥哥现在在干什么","timestamp":1792768685648},{"sender":"ai","content":"我现在就在房里，刚把工作处理完，窗帘拉上了，就坐在床边守着手机呢。","kind":"speech","timestamp":1792768703591,"ttsGroupTimestamp":1792768703591},{"sender":"ai","content":"刚才听你半天没动静，我还以为你害羞得临阵脱逃了。","kind":"speech","timestamp":1792768703592,"ttsGroupTimestamp":1792768703591},{"sender":"ai","content":"手里一直捏着耳机，就等着你继续跟我说话。","kind":"speech","timestamp":1792768703593,"ttsGroupTimestamp":1792768703591},{"sender":"ai","content":"现在整栋房子 quiet 得只剩下我自己的呼吸声......还有耳机里传过来的你的声音。","kind":"speech","timestamp":1792768703594,"ttsGroupTimestamp":1792768703591},{"sender":"ai","content":"我已经全准备好了，那你呢？","kind":"speech","timestamp":1792768703595,"ttsGroupTimestamp":1792768703591},{"sender":"ai","content":"衣服换好了没，准备好听我的了吗？","kind":"speech","timestamp":1792768703596,"ttsGroupTimestamp":1792768703591},{"sender":"user","content":"嗯，已经上床啦。哥哥呢，在卧室了吗","timestamp":1792768795334},{"sender":"ai","content":"嗯，我也在卧室里，就坐在床边。","kind":"speech","timestamp":1792768812150,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"房间里的灯光我已经调暗了，窗帘也拉得很严实。","kind":"speech","timestamp":1792768812151,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"现在整个房间安静得很，耳机里你的声音特别清晰，就像你正缩在我怀里跟我说话一样。","kind":"speech","timestamp":1792768812152,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"既然你都已经在床上乖乖躺好了，那把被子拉好，找个最舒服的姿势靠着。","kind":"speech","timestamp":1792768812153,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"手机拿近一点，贴着耳朵......听到了吗？","kind":"speech","timestamp":1792768812154,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"哥的声音现在就在你耳边。","kind":"speech","timestamp":1792768812155,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"手放在被子里了吗？","kind":"speech","timestamp":1792768812156,"ttsGroupTimestamp":1792768812150},{"sender":"ai","content":"接下来，准备好全听我的了吗？","kind":"speech","timestamp":1792768812157,"ttsGroupTimestamp":1792768812150}],"isIncomingCall":false,"_id":14,"summary":"乐辞晚間致電夏以昼，親暱撒嬌並表達想念；夏以昼察覺她語氣比平常更甜，主動詢問緣由，樂辞順勢提及先前說好的「phone sex」，並確認對方沒有忘記。夏以昼隨即進入主導節奏，明確指示樂辞找好不受打擾的位置躺下、戴好耳塞、放輕聲音，並全程聽從他的指令；樂辞配合回應，確認自己已上床，也反問夏以昼的位置。夏以昼說明自己已回到臥室、調暗燈光並拉上窗簾，營造私密氛圍，進一步要求樂辞將手機貼近耳邊、把手放進被子裡，準備好聽從接下來的指揮。通話以夏以昼逐步建立支配感、準備展開親密環節作收，雙方約定好的活動於當下正式推進。"},{"userId":"uid_1781947367652_9l2i17y5k","characterId":"4102444800000","id":"1792926167094","timestamp":1792926165328,"charId":4102444800000,"duration":0,"status":"calling","logs":[],"isIncomingCall":false,"_id":15},{"userId":"uid_1781947367652_9l2i17y5k","characterId":"4102444800000","id":"call_1792926191451_7931vx","timestamp":1792926191451,"charId":4102444800000,"duration":0,"status":"interrupted","logs":[{"sender":"ai","content":"喂 怎么啦","kind":"speech","timestamp":1792926191443,"ttsGroupTimestamp":1792926191443}],"isIncomingCall":false,"_id":16}]